// IL-2 Great Battles: MOZA AB6 + MHG stick and MOZA MTQ throttle, general WWII layout.
// Installed by DCS-Profiles.ps1 -IL2, which swaps {AB6} / {MTQ} for the joystick numbers
// the game gave those devices in data\input\devices.txt and merges these lines into
// data\input\global.actions. Button numbers here are 0-based (joyN_b0 = MOZA button 1).
// Format: action, command, invert|
rpc_roll,                                         joy{AB6}_axis_x,                                  0|
rpc_pitch,                                        joy{AB6}_axis_y,                                  0|
all_guns_fire,                                    joy{AB6}_b5,                                      0|
weapon_group_1_fire,                              joy{AB6}_b0,                                      0|
weapon_group_2_fire,                              joy{AB6}_b4,                                      0|
throw_bombs_command,                              joy{AB6}_b1,                                      0|
launch_rockets_command,                           joy{AB6}_b3,                                      0|
rpc_wheel_brakes,                                 joy{AB6}_b2,                                      0|
pitch_trim_switch_dn,                             joy{AB6}_pov0_0,                                  0|
pitch_trim_switch_up,                             joy{AB6}_pov0_180,                                0|
yaw_trim_switch_left,                             joy{AB6}_pov0_270,                                0|
yaw_trim_switch_right,                            joy{AB6}_pov0_90,                                 0|
pitch_trim_switch_dn,                             joy{AB6}_b21,                                     0|
pitch_trim_switch_up,                             joy{AB6}_b22,                                     0|
bc_head_cfovi,                                    joy{AB6}_b11,                                     0|
bc_head_cfovo,                                    joy{AB6}_b13,                                     0|
